{
  "concurrency": {
    "max_workers": 4,
    "clone_timeout": 300
  },
  "search": {
    "min_stars": 10,
    "time_window": {
      "start_date": "2024-12-01",
      "end_date": "now",
      "window_size_days": 7
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "date_format": "%Y-%m-%d %H:%M:%S"
  }
}